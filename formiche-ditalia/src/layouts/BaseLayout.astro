---
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, canonicalUrl, ogImage, structuredData } = Astro.props;
const siteTitle = "Formiche d'Italia";
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
const metaDescription = description || "La guida italiana alla mirmecologia — identificazione, catalogo specie e rete di esperti";
const siteUrl = 'https://formicheditalia.it';
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage || '/images/og-default.png', siteUrl).href;

import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.tsx';
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={currentUrl} />
  <link rel="alternate" hreflang="it" href={currentUrl} />
  <link rel="alternate" hreflang="en" href={`${currentUrl}${currentUrl.includes('?') ? '&' : '?'}lang=en`} />
  <!-- Google Search Console -->
  <meta name="google-site-verification" content="x3UJYaGbhCrgVXwTQXZjrW9iBBEu9oVd_HONJPNqRC4" />
  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:site_name" content="Formiche d'Italia" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#2d6f32" />
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  )}
</head>
<body class="min-h-screen flex flex-col">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="font-display text-xl font-bold text-forest-700 hover:text-forest-600 transition-colors">
        Formiche d'Italia
      </a>
      <div class="hidden sm:flex items-center gap-6">
        <a href="/identifica" class="text-sm font-medium text-gray-600 hover:text-forest-600 transition-colors" data-i18n="nav_identify">Identifica</a>
        <a href="/generi" class="text-sm font-medium text-gray-600 hover:text-forest-600 transition-colors" data-i18n="nav_genera">Generi</a>
        <a href="/esperti" class="text-sm font-medium text-gray-600 hover:text-forest-600 transition-colors" data-i18n="nav_experts">Esperti</a>
        <a href="/anatomia" class="text-sm font-medium text-gray-600 hover:text-forest-600 transition-colors" data-i18n="nav_anatomy">Anatomia</a>
        <a href="/chi-siamo" class="text-sm font-medium text-gray-600 hover:text-forest-600 transition-colors" data-i18n="nav_about">Chi siamo</a>
        <a href="/contatti" class="text-sm font-medium text-gray-600 hover:text-forest-600 transition-colors" data-i18n="nav_contact">Contatti</a>
        <LanguageSwitcher client:load />
      </div>
      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="sm:hidden p-2" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </nav>
  </header>
  <!-- Mobile menu (hidden by default) -->
  <div id="mobile-menu" class="sm:hidden hidden border-b border-gray-200 bg-white">
    <div class="px-4 py-3 space-y-2">
      <a href="/identifica" class="block text-sm font-medium text-gray-600 py-2" data-i18n="nav_identify">Identifica</a>
      <a href="/generi" class="block text-sm font-medium text-gray-600 py-2" data-i18n="nav_genera">Generi</a>
      <a href="/esperti" class="block text-sm font-medium text-gray-600 py-2" data-i18n="nav_experts">Esperti</a>
      <a href="/anatomia" class="block text-sm font-medium text-gray-600 py-2" data-i18n="nav_anatomy">Anatomia</a>
      <a href="/chi-siamo" class="block text-sm font-medium text-gray-600 py-2" data-i18n="nav_about">Chi siamo</a>
      <a href="/contatti" class="block text-sm font-medium text-gray-600 py-2" data-i18n="nav_contact">Contatti</a>
      <div class="py-2"><LanguageSwitcher client:load /></div>
    </div>
  </div>
  <script>
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => {
      const isHidden = mobileMenu?.classList.toggle('hidden');
      mobileBtn.setAttribute('aria-expanded', String(!isHidden));
    });
  </script>

  <main class="flex-1">
    <slot />
  </main>

  <footer class="bg-gray-50 border-t border-gray-200 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
        <div>
          <p class="text-sm text-gray-500" data-i18n="footer_credits">Un progetto di Francesco Simone Mensa</p>
          <p class="text-xs text-gray-500 mt-1" data-i18n="footer_data_credits">Immagini: AntWeb.org (CC BY-SA 3.0). Dati tassonomici: Schifani 2022.</p>
          <div class="flex flex-wrap gap-3 mt-3">
            <a href="/come-identificare-le-formiche" class="text-xs text-gray-500 hover:text-forest-600 transition-colors" data-i18n="nav_guide">Guida all'identificazione</a>
            <a href="/formiche-in-casa" class="text-xs text-gray-500 hover:text-forest-600 transition-colors" data-i18n="nav_pests">Formiche in casa</a>
            <a href="/metodi" class="text-xs text-gray-500 hover:text-forest-600 transition-colors" data-i18n="nav_methods">Metodi</a>
            <a href="/sviluppi" class="text-xs text-gray-500 hover:text-forest-600 transition-colors" data-i18n="nav_sviluppi">Sviluppi futuri</a>
            <a href="/contatti" class="text-xs text-gray-500 hover:text-forest-600 transition-colors" data-i18n="nav_contact">Contatti</a>
            <a href="/privacy" class="text-xs text-gray-500 hover:text-forest-600 transition-colors" data-i18n="nav_privacy">Privacy</a>
          </div>
        </div>
        <div class="text-xs text-gray-500 sm:text-right">
          <p>&copy; {new Date().getFullYear()} Formiche d'Italia</p>
          <p class="mt-1" data-i18n="footer_cite">Per citare: Mensa F.S. (2026). Formiche d'Italia. formicheditalia.it</p>
        </div>
      </div>
    </div>
  </footer>
  <script>
    // Apply saved language on page load (fixes language reset on navigation)
    (function() {
      var lang;
      try { lang = localStorage.getItem('lang'); } catch(e) { return; }
      if (lang && lang !== 'it') {
        document.documentElement.lang = lang;
        import('../i18n').then(({ t }) => {
          document.querySelectorAll('[data-i18n]').forEach((el) => {
            const key = el.getAttribute('data-i18n');
            if (key) {
              const value = t(key as any, lang as any);
              if (/<[a-z][\s\S]*>/i.test(value)) {
                el.innerHTML = value;
              } else {
                el.textContent = value;
              }
            }
          });
          document.querySelectorAll('[data-i18n-field]').forEach((el) => {
            const enText = el.getAttribute('data-en') || '';
            const itText = el.getAttribute('data-it') || '';
            el.textContent = enText || itText;
          });
        });
      }
    })();
  </script>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }
  </script>

  <!-- Privacy info banner (one-time) -->
  <div id="privacy-banner" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 shadow-lg">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-4">
      <p class="text-xs text-gray-600 flex-1" data-i18n="privacy_banner_text">
        Questo sito non usa cookie di profilazione. Salviamo solo la preferenza di lingua nel tuo browser.
      </p>
      <div class="flex items-center gap-3 flex-shrink-0">
        <a href="/privacy" class="text-xs text-forest-600 hover:underline font-medium" data-i18n="privacy_banner_link">Informativa</a>
        <button id="privacy-banner-close" class="px-4 py-1.5 rounded-lg bg-forest-600 text-white text-xs font-medium hover:bg-forest-700 transition-colors" data-i18n="privacy_banner_ok">Ho capito</button>
      </div>
    </div>
  </div>
  <script>
    (function() {
      try {
        if (!localStorage.getItem('privacy_ok')) {
          var b = document.getElementById('privacy-banner');
          if (b) b.classList.remove('hidden');
        }
        var btn = document.getElementById('privacy-banner-close');
        if (btn) btn.addEventListener('click', function() {
          localStorage.setItem('privacy_ok', '1');
          var b = document.getElementById('privacy-banner');
          if (b) b.classList.add('hidden');
        });
      } catch(e) {}
    })();
  </script>
</body>
</html>
