  {
    "id": "aphaenogaster-spinosa",
    "genus_id": "aphaenogaster",
    "scientific_name": "Aphaenogaster spinosa",
    "author_year": "Emery, 1878",
    "status": "native",
    "subspecies": [],
    "distribution_regions": [],
    "altitude_range": null,
    "habitat_notes": "The nests are usually under the stones of a draining soil.",
    "photo_urls": [],
    "synonyms": [],
    "antweb_url": "https://www.antweb.org/browse.do?genus=Aphaenogaster&species=spinosa&rank=species",
    "antcat_url": null,
    "gbif_id": null,
    "description_en": "Nest density can be important. The nests are monogynous and very populous. There is no mating flight but a mating close to the nest. Once fertilized, the new queen returns to nest. She left it some time later, with a group of workers and brood, to found a new colony (multiplication of colonies by cuttings). The diet is omnivorous. These species also feed the larvae with petals flowers. The workers have only a small crop, which limits the storage of liquid foods. The larvae feed directly on the food brought to the nest, without trophallaxis.",
    "body_length": "5-6 mm",
    "photo_refs": [
      "Aphaenogaster_spinosa_profilo",
      "Aphaenogaster_spinosa_dorso",
      "Aphaenogaster_spinosa_testa"
    ]
  },
  {
    "id": "aphaenogaster-subterranea",
    "genus_id": "aphaenogaster",
    "scientific_name": "Aphaenogaster subterranea",
    "author_year": "Latreille, 1798",
    "status": "native",
    "subspecies": [],
    "distribution_regions": [],
    "altitude_range": null,
    "habitat_notes": "The nests are generally under the stones. In the most humid environments, they can be found in the trunks and branches fallen to the ground. The workers go in search of food on the ground.",
    "photo_urls": [],
    "synonyms": [],
    "antweb_url": "https://www.antweb.org/browse.do?genus=Aphaenogaster&species=subterranea&rank=species",
    "antcat_url": null,
    "gbif_id": null,
    "description_en": "This is a common species. the density of the nests is generally important. The colonies are monogyous and very populous. the foundation is independent. Aphaenogaster subterranea is an insectivorous species that can nourish the larvae even with flower petals. The workers move rather slowly.",
    "body_length": "3-5 mm",
    "photo_refs": [
      "Aphaenogaster_subterranea_profilo",
      "Aphaenogaster_subterranea_dorso",
      "Aphaenogaster_subterranea_testa"
