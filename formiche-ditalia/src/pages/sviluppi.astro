---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sviluppi futuri" description="Gli sviluppi di Formiche d'Italia: cosa è stato fatto, cosa stiamo sviluppando e cosa arriverà in futuro.">

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-forest-50 via-white to-brand-50">
    <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-brand-100/30 blur-3xl"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 relative">
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-forest-900 tracking-tight" data-i18n="roadmap_title">Sviluppi futuri</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl leading-relaxed" data-i18n="roadmap_subtitle">
        Formiche d'Italia è un progetto in continua evoluzione. Ecco dove siamo e dove stiamo andando.
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Timeline line -->
    <div class="relative">
      <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gray-200 hidden sm:block"></div>

      <!-- v1.0 — Completato -->
      <div class="relative mb-16">
        <div class="flex items-start gap-6">
          <div class="hidden sm:flex w-16 h-16 rounded-full bg-forest-600 text-white items-center justify-center flex-shrink-0 z-10 shadow-lg">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <span class="text-xs font-bold uppercase tracking-wider text-white bg-forest-600 px-3 py-1 rounded-full">v1.0</span>
              <span class="text-sm text-forest-600 font-medium" data-i18n="roadmap_v1_status">Completato</span>
              <span class="text-xs text-gray-400" data-i18n="roadmap_v1_when">aprile 2026</span>
            </div>
            <h2 class="font-display text-2xl font-bold text-gray-900 mb-4" data-i18n="roadmap_v1_title">Lancio della piattaforma</h2>

            <!-- Identificazione -->
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2 mt-4" data-i18n="roadmap_label_identification">Identificazione</p>
            <div class="grid sm:grid-cols-2 gap-3 mb-4">
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v1_key">Chiave di identificazione interattiva</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v1_key_desc">Scoring pesato, tolleranza errori, suggerimento caratteri</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v1_glossary">Glossario visuale</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v1_glossary_desc">25 termini morfologici con definizioni e tooltip</p>
                </div>
              </div>
            </div>

            <!-- Catalogo -->
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2" data-i18n="roadmap_label_catalog">Catalogo</p>
            <div class="grid sm:grid-cols-2 gap-3 mb-4">
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v1_catalog">Catalogo generi e specie</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v1_catalog_desc">42 generi italiani, 79 specie di Roma, 100% foto specimen</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v1_experts">Directory esperti</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v1_experts_desc">11 mirmecologi con profilo accademico e pubblicazioni</p>
                </div>
              </div>
            </div>

            <!-- Piattaforma -->
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2" data-i18n="roadmap_label_platform">Piattaforma</p>
            <div class="grid sm:grid-cols-2 gap-3">
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v1_i18n">Bilingue IT/EN</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v1_i18n_desc">200+ chiavi di traduzione, switch in tempo reale</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v1_pwa">PWA offline</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v1_pwa_desc">Utilizzabile sul campo senza connessione internet</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v1_domain">Dominio personalizzato</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v1_domain_desc">formicheditalia.it con certificato SSL e Google Search Console</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v1_anatomy">Anatomia interattiva</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v1_anatomy_desc">Glossario anatomico con 31 strutture e illustrazioni originali</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- v1.1 — Completato -->
      <div class="relative mb-16">
        <div class="flex items-start gap-6">
          <div class="hidden sm:flex w-16 h-16 rounded-full bg-forest-600 text-white items-center justify-center flex-shrink-0 z-10 shadow-lg">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <span class="text-xs font-bold uppercase tracking-wider text-white bg-forest-600 px-3 py-1 rounded-full">v1.1</span>
              <span class="text-sm text-forest-600 font-medium" data-i18n="roadmap_v11_status">Completato</span>
              <span class="text-xs text-gray-400" data-i18n="roadmap_v11_when">giugno – luglio 2026</span>
            </div>
            <h2 class="font-display text-2xl font-bold text-gray-900 mb-4" data-i18n="roadmap_v11_title">Miglioramenti UX della chiave</h2>

            <div class="space-y-3">
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v11_hide_char">Nascondi caratteri non riconoscibili</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v11_hide_char_desc">Possibilità di escludere dalla chiave i caratteri che l'utente non riesce a osservare sul campione, con re-tarazione automatica dello scoring</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v11_skip_suggested">Skip del carattere suggerito</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v11_skip_suggested_desc">Se il carattere consigliato non è osservabile (campione rovinato, parte mancante, poco visibile) il sistema propone il successivo più discriminante</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v11_persist">Persistenza dei progressi</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v11_persist_desc">I progressi dell'identificazione restano salvati anche cambiando tab o pagina, finché non si conclude o si ricomincia</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-forest-50 rounded-xl p-4 border border-forest-100">
                <svg class="w-5 h-5 text-forest-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v11_analytics">Analytics privacy-first</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v11_analytics_desc">Vercel Analytics: statistiche di utilizzo del sito senza tracciamento individuale degli utenti</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- v1.2 — Espansione penisola (macro-area centro-meridionale) + filtro per macro-area -->
      <div class="relative mb-16">
        <div class="flex items-start gap-6">
          <div class="hidden sm:flex w-16 h-16 rounded-full bg-brand-400 text-white items-center justify-center flex-shrink-0 z-10 shadow-lg">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <span class="text-xs font-bold uppercase tracking-wider text-white bg-brand-400 px-3 py-1 rounded-full">v1.2</span>
              <span class="text-sm text-brand-500 font-medium" data-i18n="roadmap_v12_status">Prossimo step</span>
              <span class="text-xs text-gray-400" data-i18n="roadmap_v12_when">settembre – novembre 2026</span>
            </div>
            <h2 class="font-display text-2xl font-bold text-gray-900 mb-4" data-i18n="roadmap_v12_title">Espansione alla penisola e filtro per macro-area</h2>

            <div class="space-y-3">
              <div class="flex items-start gap-3 bg-brand-50 rounded-xl p-4 border border-brand-100">
                <div class="w-5 h-5 rounded-full border-2 border-brand-400 flex-shrink-0 mt-0.5"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v12_peninsula">Espansione all'Italia centro-meridionale</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v12_peninsula_desc">Da 79 specie (Roma) alle ~160 dell'Italia centro-meridionale, la prima delle tre macro-aree della checklist della fauna italiana</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-brand-50 rounded-xl p-4 border border-brand-100">
                <div class="w-5 h-5 rounded-full border-2 border-brand-400 flex-shrink-0 mt-0.5"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v12_macroarea">Filtro per macro-area</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v12_macroarea_desc">Restringi i candidati nella chiave in base alla macro-area di osservazione — Italia settentrionale, centro-meridionale o insulare — secondo la checklist della fauna italiana</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-brand-50 rounded-xl p-4 border border-brand-100">
                <div class="w-5 h-5 rounded-full border-2 border-brand-400 flex-shrink-0 mt-0.5"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v12_new_records">Nuove Temnothorax post-2022</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v12_new_records_desc">Aggiunta di T. siculus, T. apenninicus, T. marae, T. poldii e T. vivianoi, descritte dopo il 2022</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- v2.0 — Chiave specie + caste -->
      <div class="relative mb-16">
        <div class="flex items-start gap-6">
          <div class="hidden sm:flex w-16 h-16 rounded-full bg-gray-400 text-white items-center justify-center flex-shrink-0 z-10 shadow-lg">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <span class="text-xs font-bold uppercase tracking-wider text-white bg-gray-400 px-3 py-1 rounded-full">v2.0</span>
              <span class="text-sm text-gray-500 font-medium" data-i18n="roadmap_v2_status">Prossimamente</span>
              <span class="text-xs text-gray-400" data-i18n="roadmap_v2_when">dicembre 2026 – Q1 2027</span>
            </div>
            <h2 class="font-display text-2xl font-bold text-gray-900 mb-4" data-i18n="roadmap_v2_title">Chiave a livello di specie</h2>

            <div class="space-y-3">
              <div class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200">
                <div class="w-5 h-5 rounded-full border-2 border-gray-300 flex-shrink-0 mt-0.5"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v2_species_key">Chiave morfologica per le specie</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v2_species_key_desc">Estensione della chiave dal livello di genere al livello di specie, partendo dalle specie dell'Italia centro-meridionale</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200">
                <div class="w-5 h-5 rounded-full border-2 border-gray-300 flex-shrink-0 mt-0.5"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v2_modes">Doppia modalità</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v2_modes_desc">Versione semplificata per principianti e completa per esperti</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200">
                <div class="w-5 h-5 rounded-full border-2 border-gray-300 flex-shrink-0 mt-0.5"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v2_caste">Gestione caste</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v2_caste_desc">Operaia, regina o maschio come filtro iniziale</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- v2.1 — AI pre-filtro specie -->
      <div class="relative mb-16">
        <div class="flex items-start gap-6">
          <div class="hidden sm:flex w-16 h-16 rounded-full bg-gray-300 text-gray-700 items-center justify-center flex-shrink-0 z-10 shadow-lg">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7l9-4 9 4M3 7v10l9 4 9-4V7M3 7l9 4m0 0l9-4m-9 4v10" /></svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <span class="text-xs font-bold uppercase tracking-wider text-white bg-gray-400 px-3 py-1 rounded-full">v2.1</span>
              <span class="text-sm text-gray-500 font-medium" data-i18n="roadmap_v21_status">Prossimamente</span>
              <span class="text-xs text-gray-400" data-i18n="roadmap_v21_when">Q1 – Q2 2027</span>
            </div>
            <h2 class="font-display text-2xl font-bold text-gray-900 mb-4" data-i18n="roadmap_v21_title">Pre-filtro AI da foto</h2>

            <div class="space-y-3">
              <div class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200">
                <div class="w-5 h-5 rounded-full border-2 border-gray-300 flex-shrink-0 mt-0.5"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v21_model">Modello ML per identificazione di specie</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v21_model_desc">Deploy del modello v2.5 (227 specie italiane, val_top1 ~78%) come pre-filtro che restringe i candidati prima della chiave morfologica. Output: top-5 specie con confidenze</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200">
                <div class="w-5 h-5 rounded-full border-2 border-gray-300 flex-shrink-0 mt-0.5"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900" data-i18n="roadmap_v21_iteration">Iterazione del modello in background</p>
                  <p class="text-xs text-gray-500 mt-0.5" data-i18n="roadmap_v21_iteration_desc">Nuove versioni del modello vengono addestrate offline e sostituite silenziosamente quando migliorano la val_acc</p>
                </div>
              </div>
              <div class="flex items-start gap-3 bg-gray-50 rounded-xl p-4 border border-gray-200">
                <div class="w-5 h-5 rounded-full border-2 border-gray-300 flex-shrink-0 mt-0.5"></div>
                <div>
