---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina non trovata" description="La pagina richiesta non esiste.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-6xl font-bold text-forest-200 mb-4">404</p>
    <h1 class="font-display text-2xl sm:text-3xl font-bold text-gray-900 mb-4" data-i18n="error_404_title">Pagina non trovata</h1>
    <p class="text-gray-600 mb-8" data-i18n="error_404_desc">La pagina che stai cercando non esiste o è stata spostata.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-forest-600 text-white font-semibold hover:bg-forest-700 transition-colors" data-i18n="error_404_home">
        Torna alla homepage
      </a>
      <a href="/identifica/" class="inline-flex items-center justify-center px-6 py-3 rounded-xl border-2 border-forest-200 text-forest-700 font-semibold hover:border-forest-400 transition-colors" data-i18n="error_404_identify">
        Identifica una formica
      </a>
    </div>
  </div>
</BaseLayout>
