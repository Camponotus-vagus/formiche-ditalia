---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnatomyExplorer from '../components/AnatomyExplorer.tsx';
import characters from '../data/characters.json';
---

<BaseLayout title="Anatomia della formica" titleEn="Ant anatomy" description="Guida visuale all'anatomia della formica: le regioni del corpo e i caratteri morfologici usati per l'identificazione.">

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-forest-50 via-white to-brand-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-forest-900 tracking-tight" data-i18n="anatomy_title">Anatomia della formica</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl leading-relaxed" data-i18n="anatomy_subtitle">
        Le formiche hanno un corpo diviso in regioni ben distinte. Conoscerle è il primo passo per usare la chiave di identificazione.
      </p>
    </div>
  </section>

  <!-- Glossario anatomico interattivo -->
  <section class="py-12 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <AnatomyExplorer client:load characters={characters} />
      <p class="text-center text-sm text-gray-400 mt-8" data-i18n="anatomy_attribution">
  Illustrazioni originali di Francesco Simone Mensa, dalla tesi
  <a
    href="https://www.researchgate.net/publication/330994606_Chiave_interattiva_per_il_riconoscimento_dei_generi_di_Formicidae_italiani_e_delle_specie_della_citta_di_Roma"
    target="_blank"
    rel="noopener noreferrer"
    class="text-forest-600 hover:underline"
  >"Chiave interattiva per il riconoscimento dei generi di Formicidae italiani e delle specie della città di Roma"</a>
  (Mensa, 2017).
</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 bg-gradient-to-br from-forest-600 to-forest-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl font-bold text-white" data-i18n="anatomy_cta_title">Pronto a provare la chiave?</h2>
      <p class="mt-3 text-forest-100" data-i18n="anatomy_cta_desc">Usa i caratteri che hai imparato per identificare un genere di formica.</p>
      <a href="/identifica/" class="inline-flex items-center justify-center mt-6 px-6 py-3 rounded-xl bg-white text-forest-700 font-semibold hover:bg-forest-50 transition-colors" data-i18n="anatomy_cta_button">Apri la chiave</a>
    </div>
  </section>

</BaseLayout>
